---
import { SITE } from 'astrowind:config';

import Layout from '~/layouts/Layout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Rail from '~/components/site/Rail.astro';
import SiteHeader from '~/components/site/SiteHeader.astro';
import PathRow from '~/components/site/PathRow.astro';
import SiteFooter from '~/components/site/SiteFooter.astro';
import { brand, contact, projects } from '~/data/site';

const metadata = {
  title: contact.metaTitle,
  ignoreTitleTemplate: true,
  description: contact.metaDescription,
  openGraph: { type: 'website' },
};

const siteUrl = SITE.site ?? 'https://multnelis.org';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${siteUrl}/contact#page`,
  url: `${siteUrl}/contact`,
  name: contact.metaTitle,
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: SITE.name,
    url: siteUrl,
    email: brand.email,
    contactPoint: { '@type': 'ContactPoint', email: brand.email, contactType: 'general' },
  },
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <main>
    <section class="gs hero" id="top" data-kind="hero" aria-label="Contact" data-i18n-aria="ui.contact">
      <Rail />
      <SiteHeader current="contact" />
      <div class="hero-body col">
        <h1 data-i18n="contact.title">{contact.title.en}</h1>
        <p class="lead" data-i18n="contact.lead">{contact.lead.en}</p>
        <div class="actions" data-anchor>
          <a class="action action-solid" href={`mailto:${brand.email}`} data-i18n="contact.action">
            {contact.action.en}
          </a>
          <a class="addr mono" href={`mailto:${brand.email}`}>{brand.email}</a>
        </div>
      </div>
    </section>

    {/* Only main runs here: each project's lane forks at its own row. */}
    <section class="gs group" data-kind="through" aria-labelledby="projects-title">
      <Rail />
      <div class="col">
        <h2 id="projects-title" data-i18n="contact.projects">{contact.projects.en}</h2>
      </div>
    </section>
    {projects.map((project) => <PathRow project={project} />)}
  </main>

  <SiteFooter />
</Layout>

<style>
  /* The project rows are the recommended route, so they follow the address closely. */
  .hero-body {
    padding-top: 112px;
    padding-bottom: 88px;
  }
  h1 {
    font-weight: 800;
    font-size: clamp(2.75rem, 1.1rem + 5.4vw, 5.5rem);
    line-height: 0.98;
    max-width: 1140px;
  }
  .lead {
    margin-top: 36px;
    font-size: 1.25rem;
    line-height: 1.5;
    max-width: 62ch;
  }
  .actions {
    gap: 12px 24px;
    margin-top: 44px;
  }
  .addr {
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    transition: text-decoration-color 160ms ease;
  }
  .addr:hover {
    text-decoration-color: currentColor;
  }
  .group .col {
    padding-top: 56px;
    padding-bottom: 28px;
  }
  .group h2 {
    font-weight: 800;
    font-size: clamp(2.125rem, 1.4rem + 2.2vw, 3.25rem);
    line-height: 1;
  }

  @media (width <= 720px) {
    .hero-body {
      padding-top: 56px;
      padding-bottom: 56px;
    }
    h1 {
      font-size: 2.5rem;
      line-height: 1;
      text-wrap: pretty;
    }
    .lead {
      margin-top: 26px;
      font-size: 1.125rem;
    }
    .actions {
      margin-top: 32px;
    }
    .addr {
      text-align: center;
    }
    .group .col {
      padding-top: 40px;
      padding-bottom: 20px;
    }
  }
</style>
