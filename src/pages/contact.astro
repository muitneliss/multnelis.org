---
import { SITE } from 'astrowind:config';

import Layout from '~/layouts/Layout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Rail from '~/components/site/Rail.astro';
import SiteHeader from '~/components/site/SiteHeader.astro';
import SiteFooter from '~/components/site/SiteFooter.astro';
import { brand, contact } from '~/data/site';

const metadata = {
  title: contact.metaTitle,
  ignoreTitleTemplate: true,
  description: contact.metaDescription,
  openGraph: { type: 'website' },
};

const siteUrl = SITE.site ?? 'https://multnelis.org';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${siteUrl}/contact#page`,
  url: `${siteUrl}/contact`,
  name: contact.metaTitle,
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: SITE.name,
    url: siteUrl,
    email: brand.email,
    contactPoint: { '@type': 'ContactPoint', email: brand.email, contactType: 'general' },
  },
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <main>
    <section class="gs hero" id="top" data-kind="hero" aria-label="Contact" data-i18n-aria="ui.contact">
      <Rail />
      <SiteHeader current="contact" />
      <div class="hero-body col">
        <h1 data-i18n="contact.title">{contact.title.en}</h1>
        <div class="actions" data-anchor>
          <a class="action action-solid" href={`mailto:${brand.email}`} data-i18n="contact.action">
            {contact.action.en}
          </a>
          <a class="addr mono" href={`mailto:${brand.email}`}>{brand.email}</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* One screen: the hero stretches so the footer closes the viewport. */
  :global(body) {
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .hero {
    flex: 1;
  }
  .hero-body {
    padding-top: 112px;
    padding-bottom: 136px;
  }
  h1 {
    font-weight: 800;
    font-size: clamp(2.75rem, 1.1rem + 5.4vw, 5.5rem);
    line-height: 0.98;
    max-width: 1140px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 48px;
  }
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font: 600 1rem/1 var(--body);
    padding: 15px 22px;
    border-radius: 7px;
    text-decoration: none;
    border: 1px solid var(--ink);
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 300ms var(--ease);
  }
  .action-solid {
    background: var(--ink);
    color: #fff;
  }
  .action-solid:hover {
    background: #262a2f;
    border-color: #262a2f;
  }
  .action:active {
    transform: translateY(1px);
  }
  .addr {
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    transition: text-decoration-color 160ms ease;
  }
  .addr:hover {
    text-decoration-color: currentColor;
  }

  @media (width <= 720px) {
    .hero-body {
      padding-top: 56px;
      padding-bottom: 88px;
    }
    h1 {
      font-size: 2.5rem;
      line-height: 1;
      text-wrap: pretty;
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
      margin-top: 32px;
    }
    .action {
      width: 100%;
    }
    .addr {
      text-align: center;
    }
  }
</style>
