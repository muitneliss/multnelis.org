---
import { SITE } from 'astrowind:config';

import Layout from '~/layouts/Layout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Hero from '~/components/site/Hero.astro';
import MemberField from '~/components/site/MemberField.astro';
import Projects from '~/components/site/Projects.astro';
import SiteFooter from '~/components/site/SiteFooter.astro';
import { brand, members, projects, statement } from '~/data/site';

const metadata = {
  title: 'multnelis — open-source tools for the coding-agent era',
  ignoreTitleTemplate: true,
  description:
    'multnelis is a small open-source collective in Ho Chi Minh City building tools for the coding-agent era: Undercroft, Ymir, Symphony, and Text Transporter.',
  openGraph: { type: 'website' },
};

// WebSite + Organization from config.yaml, the three members as Person entries
// pointing at their GitHub profiles, and each public project with its
// repository. Nothing here that is not on the page.
const siteUrl = SITE.site ?? 'https://multnelis.org';
const orgId = `${siteUrl}/#organization`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: SITE.name,
      description: statement.en,
      inLanguage: ['en', 'vi'],
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.name,
      url: siteUrl,
      description: statement.en,
      email: brand.email,
      sameAs: [brand.github],
      location: { '@type': 'Place', name: 'Ho Chi Minh City, Vietnam' },
    },
    ...members.map((m) => ({
      '@type': 'Person',
      name: m.name,
      alternateName: m.handle !== m.name ? m.handle : undefined,
      url: m.github,
      sameAs: m.site ? [m.site] : undefined,
      memberOf: { '@id': orgId },
    })),
    ...projects.flatMap((p) =>
      p.repo
        ? [
            {
              '@type': 'SoftwareSourceCode',
              name: p.name,
              description: p.tagline.en,
              codeRepository: p.repo.url,
              author: { '@id': orgId },
            },
          ]
        : []
    ),
  ],
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <main>
    <Hero />

    {members.map((member, i) => <MemberField member={member} id={i === 0 ? 'members' : undefined} />)}

    <Projects />
  </main>

  <SiteFooter />
</Layout>
