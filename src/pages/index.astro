---
import { SITE } from 'astrowind:config';

import Layout from '~/layouts/Layout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Hero from '~/components/site/Hero.astro';
import Profile from '~/components/site/Profile.astro';
import ProjectField from '~/components/site/ProjectField.astro';
import Principles from '~/components/site/Principles.astro';
import Closing from '~/components/site/Closing.astro';
import SiteFooter from '~/components/site/SiteFooter.astro';
import { brand, projects, statement, supporting } from '~/data/site';

const metadata = {
  title: 'multnelis — an engineering team in Ho Chi Minh City: Undercroft, Ymir, Text Transporter',
  ignoreTitleTemplate: true,
  description: supporting.en,
  openGraph: { type: 'website' },
};

// WebSite + Organization from config.yaml, plus each public project as
// SoftwareSourceCode. Nothing here that is not on the page.
const siteUrl = SITE.site ?? 'https://multnelis.org';
const orgId = `${siteUrl}/#organization`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: SITE.name,
      description: statement.en,
      inLanguage: ['en', 'vi'],
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.name,
      url: siteUrl,
      email: brand.email,
      foundingDate: brand.since,
      sameAs: [brand.github],
      location: { '@type': 'Place', name: 'Ho Chi Minh City, Vietnam' },
    },
    ...projects.map((p) => ({
      '@type': 'SoftwareSourceCode',
      '@id': `${siteUrl}/#${p.slug}`,
      name: p.name,
      description: p.tagline.en,
      codeRepository: p.repo.url,
      url: p.site?.url ?? p.repo.url,
      license: p.license,
      author: { '@id': orgId },
    })),
  ],
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <main>
    <Hero />
    <Profile />
    <div id="projects" role="region" aria-label="Projects" data-i18n-aria="ui.projects">
      {projects.map((project) => <ProjectField project={project} />)}
    </div>
    <Principles />
    <Closing />
  </main>

  <SiteFooter />
</Layout>
