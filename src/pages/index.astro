---
import { SITE } from 'astrowind:config';

import Layout from '~/layouts/Layout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Hero from '~/components/site/Hero.astro';
import MemberField from '~/components/site/MemberField.astro';
import ProjectCommit from '~/components/site/ProjectCommit.astro';
import SiteFooter from '~/components/site/SiteFooter.astro';
import { brand, members, projects, statement } from '~/data/site';

const metadata = {
  title: 'multnelis — a small collective in Ho Chi Minh City building tools for the coding-agent era',
  ignoreTitleTemplate: true,
  openGraph: { type: 'website' },
};

// WebSite + Organization from config.yaml, plus the three members as Person
// entries pointing at their GitHub profiles. Nothing here that is not on the page.
const siteUrl = SITE.site ?? 'https://multnelis.org';
const orgId = `${siteUrl}/#organization`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: SITE.name,
      description: statement.en,
      inLanguage: ['en', 'vi'],
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.name,
      url: siteUrl,
      sameAs: [brand.github],
      location: { '@type': 'Place', name: 'Ho Chi Minh City, Vietnam' },
    },
    ...members.map((m) => ({
      '@type': 'Person',
      name: m.name,
      alternateName: m.handle !== m.name ? m.handle : undefined,
      url: m.github,
      sameAs: m.site ? [m.site] : undefined,
      memberOf: { '@id': orgId },
    })),
  ],
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <main>
    <Hero />

    {members.map((member, i) => <MemberField member={member} id={i === 0 ? 'members' : undefined} />)}

    <div id="projects" role="region" aria-label="Projects" data-i18n-aria="ui.projects">
      {projects.map((project) => <ProjectCommit project={project} />)}
    </div>
  </main>

  <SiteFooter />
</Layout>
