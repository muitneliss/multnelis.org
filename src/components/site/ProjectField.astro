---
// One project, one branch. The section is a full-bleed field in the project's
// lane colour; the rail forks off main above the project's name and the
// commit node sits beside it. Left: what it is and what you would use it for.
// Right: the repository facts and the one thing that gets you started.
import { Icon } from 'astro-icon/components';
import Rail from '~/components/site/Rail.astro';
import ymirMark from '~/assets/images/ymir.svg';
import textTransporterMark from '~/assets/images/text-transporter.svg';
import { type Project, lanes } from '~/data/site';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const { slug, name, tagline, detail, useCases, tags, repo, site, start, license, status, lane, mark } = project;

/* Lanes that already forked above this project keep running through. */
const through = lanes.slice(0, lanes.indexOf(lane)).join(',');
const headingId = `project-${slug}`;
---

<section
  class:list={['gs', 'project', `p-${lane}`]}
  id={slug}
  data-kind="fork"
  data-lane={lane}
  data-through={through || undefined}
  aria-labelledby={headingId}
>
  <Rail />
  <div class="field">
    <div class="grid">
      <div class="main">
        <div class="head" data-pulse-lane={lane} data-arrive="0">
          <span class="tile" aria-hidden="true">
            {mark === 'undercroft' && <Icon name="undercroft" class="mark" />}
            {mark === 'ymir' && <img class="mark" src={ymirMark.src} width="56" height="56" alt="" />}
            {
              mark === 'text-transporter' && (
                <img class="mark" src={textTransporterMark.src} width="56" height="56" alt="" />
              )
            }
          </span>
          <div>
            <h2 id={headingId} data-anchor>{name}</h2>
            <p class="refs mono">
              <a class="chip" href={repo.url}><span>{repo.label}</span>&nbsp;→</a>
              {status && <span class="status">{status}</span>}
            </p>
          </div>
        </div>
        <p class="tagline" data-arrive="1" data-i18n={`project.${slug}.tagline`}>{tagline.en}</p>
        <p class="detail" data-i18n={`project.${slug}.detail`}>{detail.en}</p>

        <h3 class="uses-title" id={`${slug}-uses`} data-i18n="ui.useCases">Use cases</h3>
        <ul class="uses" aria-labelledby={`${slug}-uses`}>
          {
            useCases.map((u, i) => (
              <li>
                <p class="use-title" data-i18n={`project.${slug}.use.${i}.title`}>
                  {u.title.en}
                </p>
                <p class="use-text" data-i18n={`project.${slug}.use.${i}.text`}>
                  {u.text.en}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <dl class="facts mono">
        <dt>repo</dt>
        <dd>
          <a class="arrow" href={repo.url}><span>{repo.label}</span>&nbsp;→</a>
        </dd>
        {
          site && (
            <>
              <dt>site</dt>
              <dd>
                <a class="arrow" href={site.url}>
                  <span>{site.label}</span>&nbsp;→
                </a>
              </dd>
            </>
          )
        }
        {
          start && (
            <>
              <dt>{start.key}</dt>
              <dd>
                <code>{start.value}</code>
              </dd>
            </>
          )
        }
        <dt>stack</dt>
        <dd>{tags}</dd>
        {
          license && (
            <>
              <dt>license</dt>
              <dd>{license}</dd>
            </>
          )
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .field {
    --focus: #fff;
    margin-left: var(--rail);
    padding: 104px var(--gutter) 112px;
    color: #fff;
  }
  .p-u .field {
    background: var(--lane-u);
  }
  .p-y .field {
    background: var(--lane-y);
  }
  .p-t .field {
    background: var(--lane-t);
  }
  .p-u .field ::selection {
    background: #fff;
    color: var(--lane-u);
  }
  .p-y .field ::selection {
    background: #fff;
    color: var(--lane-y);
  }
  .p-t .field ::selection {
    background: #fff;
    color: var(--lane-t);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 40px 72px;
    align-items: start;
    max-width: 1400px;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  /* The marks carry their own colours, so they sit on the page's white. */
  .tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    border-radius: 18px;
    background: #fff;
    color: var(--ink);
    transition: transform 500ms var(--ease);
  }
  .head:hover .tile {
    transform: rotate(-4deg) scale(1.04);
  }
  .tile :global(.mark) {
    width: 56px;
    height: 56px;
    border-radius: 8px;
  }
  h2 {
    font-weight: 800;
    font-size: clamp(2.125rem, 1.4rem + 2.2vw, 3.25rem);
    line-height: 1;
    color: #fff;
  }
  /* The repository is the page's promise, so its link sits right under the name. */
  .refs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: 12px;
    font-size: 0.875rem;
    line-height: 1;
  }
  .chip {
    display: inline-flex;
    padding: 6px 9px;
    border: 1px solid rgb(255 255 255 / 70%);
    border-radius: 5px;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 180ms ease,
      color 180ms ease;
  }
  .chip:hover {
    background: #fff;
    border-color: #fff;
  }
  .p-u .chip:hover {
    color: var(--lane-u);
  }
  .p-y .chip:hover {
    color: var(--lane-y);
  }
  .p-t .chip:hover {
    color: var(--lane-t);
  }
  .status {
    font-size: 0.8125rem;
  }
  .tagline {
    margin-top: 40px;
    font-family: var(--display);
    font-stretch: 125%;
    font-variation-settings: 'wdth' 125;
    letter-spacing: -0.02em;
    text-wrap: balance;
    font-weight: 700;
    font-size: clamp(1.75rem, 1.1rem + 1.8vw, 2.375rem);
    line-height: 1.08;
    max-width: 26ch;
  }
  .detail {
    margin-top: 24px;
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 64ch;
  }

  .uses-title {
    margin-top: 56px;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.1;
  }
  .uses {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 40px;
    max-width: 920px;
  }
  .uses li {
    padding: 20px 0 24px;
    border-top: 1px solid rgb(255 255 255 / 45%);
  }
  .use-title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .use-text {
    margin-top: 8px;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .facts {
    margin: 12px 0 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 14px;
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  /* Keys stay full white: a dimmed white drops under 4.5:1 on the lane colours. */
  .facts dt {
    font-weight: 500;
  }
  .facts dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  code {
    font: inherit;
    display: inline-block;
    padding: 2px 6px;
    margin: -2px 0;
    border: 1px solid rgb(255 255 255 / 70%);
    border-radius: 4px;
    user-select: all;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
    .head:hover .tile {
      transform: none;
    }
  }
  @media (width <= 1100px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .facts {
      margin-top: 0;
    }
  }
  @media (width <= 720px) {
    .field {
      padding: 56px var(--gutter) 64px;
    }
    /* A phone has no room for the tile beside a wide name: the tile goes on top. */
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
    /* Sized so the longest word, "Transporter", fits a 320px phone. */
    h2 {
      font-size: clamp(1.625rem, 0.9rem + 3.4vw, 2.125rem);
    }
    .tile {
      width: 64px;
      height: 64px;
      border-radius: 14px;
    }
    .tile :global(.mark) {
      width: 40px;
      height: 40px;
      border-radius: 6px;
    }
    .refs {
      margin-top: 10px;
      font-size: 0.8125rem;
    }
    .tagline {
      margin-top: 28px;
    }
    .detail {
      margin-top: 18px;
      font-size: 1.0625rem;
    }
    .uses-title {
      margin-top: 40px;
    }
    .uses {
      grid-template-columns: minmax(0, 1fr);
    }
    .uses li {
      padding: 16px 0 20px;
    }
    .use-text {
      font-size: 1rem;
    }
  }
</style>
