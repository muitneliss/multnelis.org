---
// The rail placeholder for one graph section. The paths and commit nodes are
// generated by the script below from the section's measured layout, so the
// lanes land exactly on their anchors (the headline, an avatar, a tagline)
// at every viewport. Astro bundles the script once no matter how many rails
// the page renders.
---

<svg class="rail" aria-hidden="true"></svg>

<script>
  /* Commit-graph rail: measured layout, drawn on scroll, pulsed on hover. */

  type Lane = 'm' | 'c' | 't' | 'y';
  type Member = Exclude<Lane, 'm'>;

  const html = document.documentElement;
  const body = document.body;
  const STATIC =
    matchMedia('(prefers-reduced-motion: reduce)').matches || /[?&#]static/.test(location.search + location.hash);
  if (STATIC) html.classList.add('is-static');

  const NS = 'http://www.w3.org/2000/svg';
  const COLOR: Record<Lane, string> = { m: 'var(--ink)', c: 'var(--c)', t: 'var(--t)', y: 'var(--y)' };
  const FAR_TO_NEAR: Member[] = ['y', 't', 'c'];

  const mk = (name: string, attrs: Record<string, string | number>) => {
    const el = document.createElementNS(NS, name);
    for (const k in attrs) el.setAttribute(k, String(attrs[k]));
    return el;
  };
  const f = (n: number) => Math.round(n * 100) / 100;

  function geom() {
    const W = parseFloat(getComputedStyle(html).getPropertyValue('--rail')) || 120;
    const mob = W < 80;
    return {
      W,
      mob,
      x: { m: W * 0.2, c: W * 0.4, t: W * 0.6, y: W * 0.8 } as Record<Lane, number>,
      r: mob ? 6 : 8,
      ring: mob ? 2.5 : 3,
      R: mob ? 10 : 14,
      ringR: mob ? 3 : 4,
      D: mob ? 44 : 76,
      B: mob ? 96 : 168,
      run: mob ? 112 : 190,
    };
  }
  type Geom = ReturnType<typeof geom>;

  /* S-curve between two lane columns. */
  const bend = (x0: number, y0: number, x1: number, y1: number) =>
    `C ${f(x0)} ${f((y0 + y1) / 2)} ${f(x1)} ${f((y0 + y1) / 2)} ${f(x1)} ${f(y1)}`;

  function anchorY(sec: HTMLElement) {
    const a = sec.querySelector('[data-anchor]');
    if (!a) return sec.getBoundingClientRect().height / 2;
    const r = a.getBoundingClientRect();
    const s = sec.getBoundingClientRect();
    return r.top - s.top + r.height / 2;
  }

  function node(g: Geom, x: number, y: number, lane: Lane, opts: { big?: boolean; hollow?: boolean } = {}) {
    const grp = mk('g', { class: 'node' });
    const r = opts.big ? g.R : g.r;
    const ring = opts.big ? g.ringR : g.ring;
    if (opts.hollow) {
      grp.appendChild(mk('circle', { cx: f(x), cy: f(y), r: r + ring + 1.5, fill: '#fff' }));
      grp.appendChild(mk('circle', { cx: f(x), cy: f(y), r, fill: '#fff', stroke: COLOR[lane], 'stroke-width': ring }));
    } else {
      grp.appendChild(
        mk('circle', { cx: f(x), cy: f(y), r: r + ring / 2, fill: COLOR[lane], stroke: '#fff', 'stroke-width': ring })
      );
    }
    return grp;
  }

  const lanes = (s: string | undefined) => (s || '').split(',').filter(Boolean) as Member[];

  function build(sec: HTMLElement) {
    const svg = sec.querySelector<SVGSVGElement>('svg.rail');
    if (!svg) return;
    const g = geom();
    const H = Math.max(1, Math.round(sec.getBoundingClientRect().height));
    const A = anchorY(sec);
    const kind = sec.dataset.kind;
    const merge = lanes(sec.dataset.merge);
    const through = lanes(sec.dataset.through);
    const xm = g.x.m;
    const paths: Element[] = [];
    const nodes: Element[] = [];
    const P = (lane: Lane, d: string) => paths.push(mk('path', { class: 'lane-' + lane, d }));

    if (kind === 'hero') {
      /* Main starts at the merge node and runs to the bottom. */
      P('m', `M ${f(xm)} ${f(A)} L ${f(xm)} ${H}`);
      for (const l of FAR_TO_NEAR) {
        const x = g.x[l];
        const top = Math.max(8, A - g.run);
        P(l, `M ${f(x)} 0 L ${f(x)} ${f(top)} ${bend(x, top, xm, A)}`);
      }
      nodes.push(node(g, xm, A, 'm', { big: true }));
    }

    if (kind === 'member') {
      P('m', `M ${f(xm)} 0 L ${f(xm)} ${H}`);
      for (const l of through) P(l, `M ${f(g.x[l])} 0 L ${f(g.x[l])} ${H}`);
      const l = sec.dataset.lane as Member;
      const x = g.x[l];
      const B = Math.min(g.B, A - 10);
      const y0 = A - B;
      const y1 = A - B * 0.22;
      P(l, `M ${f(xm)} ${f(y0)} ${bend(xm, y0, x, y1)} L ${f(x)} ${H}`);
      /* The commit the branch forked from. */
      const fork = mk('g', { class: 'node' });
      fork.appendChild(mk('circle', { cx: f(xm), cy: f(y0), r: g.mob ? 3 : 4.5, fill: COLOR.m }));
      nodes.push(fork);
      nodes.push(node(g, x, A, l));
    }

    if (kind === 'merge') {
      P('m', `M ${f(xm)} 0 L ${f(xm)} ${H}`);
      for (const l of through) P(l, `M ${f(g.x[l])} 0 L ${f(g.x[l])} ${H}`);
      /* Farthest lanes first so the nearest draws on top. */
      for (const l of FAR_TO_NEAR.filter((k) => merge.includes(k))) {
        const x = g.x[l];
        const D = Math.min(g.D, A - 8, H - A - 8);
        P(l, `M ${f(x)} 0 L ${f(x)} ${f(A - D)} ${bend(x, A - D, xm, A)} ${bend(xm, A, x, A + D)} L ${f(x)} ${H}`);
      }
      nodes.push(node(g, xm, A, 'm', { hollow: sec.hasAttribute('data-hollow') }));
    }

    if (kind === 'end') {
      P('m', `M ${f(xm)} 0 L ${f(xm)} ${f(A)}`);
      for (const l of FAR_TO_NEAR.filter((k) => merge.includes(k))) {
        const x = g.x[l];
        const D = Math.min(g.D, A - 8);
        P(l, `M ${f(x)} 0 L ${f(x)} ${f(A - D)} ${bend(x, A - D, xm, A)}`);
      }
      nodes.push(node(g, xm, A, 'm', { big: true }));
    }

    svg.setAttribute('viewBox', `0 0 ${g.W} ${H}`);
    svg.setAttribute('width', String(g.W));
    svg.setAttribute('height', String(H));
    svg.replaceChildren(...paths, ...nodes);

    if (!STATIC && !sec.classList.contains('drawn')) {
      for (const p of paths as SVGPathElement[]) {
        const L = p.getTotalLength();
        p.setAttribute('stroke-dasharray', String(f(L + 40)));
        p.setAttribute('stroke-dashoffset', String(f(L + 50)));
      }
    }
  }

  const sections = Array.from(document.querySelectorAll<HTMLElement>('.gs'));
  const buildAll = () => sections.forEach(build);

  if (STATIC) sections.forEach((s) => s.classList.add('drawn'));
  buildAll();
  if (document.fonts?.ready) document.fonts.ready.then(buildAll);
  window.addEventListener('load', buildAll);
  /* The language toggle changes line counts, so the anchors move. */
  document.addEventListener('muitnelis:lang', buildAll);

  const ro = new ResizeObserver((entries) => {
    for (const e of entries) build(e.target as HTMLElement);
  });
  sections.forEach((s) => ro.observe(s));

  if (!STATIC) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('drawn');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    sections.forEach((s) => io.observe(s));
  }

  /* Hover a member's avatar: that lane pulses on the whole rail. */
  document.querySelectorAll<HTMLElement>('[data-avatar][data-lane]').forEach((el) => {
    el.addEventListener('mouseenter', () => {
      body.dataset.pulse = el.dataset.lane;
    });
    el.addEventListener('mouseleave', () => {
      delete body.dataset.pulse;
    });
  });
</script>
