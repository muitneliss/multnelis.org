---
// The rail placeholder for one graph section. The paths and commit nodes are
// generated by ./rail/controller.ts from the section's measured layout, so the
// lanes land exactly on their anchors (the headline, a project's name, a row)
// at every viewport, and drawn as far as the reader has scrolled. Astro
// bundles the script once no matter how many rails the page renders.
---

<svg class="rail" aria-hidden="true"></svg>

<script>
  import { startRail } from './rail/controller';

  /* Draw-on-scroll, landing commits and the overture: one controller owns them all. */
  startRail();

  /* Point at a project, by hover or keyboard focus: its lane pulses on the whole
     rail. Hover and focus are tracked apart so leaving one keeps the other. */
  const body = document.body;
  let hovered: string | undefined;
  let focused: string | undefined;
  const pulse = () => {
    const lane = hovered ?? focused;
    if (lane) body.dataset.pulse = lane;
    else delete body.dataset.pulse;
  };
  document.querySelectorAll<HTMLElement>('[data-pulse-lane]').forEach((el) => {
    const lane = el.dataset.pulseLane;
    el.addEventListener('mouseenter', () => ((hovered = lane), pulse()));
    el.addEventListener('mouseleave', () => ((hovered = undefined), pulse()));
    el.addEventListener('focusin', () => ((focused = lane), pulse()));
    el.addEventListener('focusout', () => ((focused = undefined), pulse()));
  });
</script>
