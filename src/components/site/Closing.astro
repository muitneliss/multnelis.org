---
// The close before the last commit: how to use what we build and how to
// reach us. Every lane passes straight through to the footer, where they merge.
import Rail from '~/components/site/Rail.astro';
import { brand, closing, lanes } from '~/data/site';
---

<section class="gs closing" data-kind="through" data-through={lanes.join(',')} aria-labelledby="closing-title">
  <Rail />
  <div class="col">
    <h2 id="closing-title" data-i18n="closing.title">{closing.title.en}</h2>
    <p class="lead" data-i18n="closing.lead">{closing.lead.en}</p>
    <div class="actions">
      <a class="action action-solid" href={`mailto:${brand.email}`} data-i18n="closing.action">
        {closing.action.en}
      </a>
      <a class="action action-ghost" href="/contact" data-i18n="ui.contactRoutes"> Every contact route </a>
    </div>
  </div>
</section>

<style>
  .closing {
    border-top: 1px solid var(--hair);
  }
  .col {
    padding-top: 112px;
    padding-bottom: 120px;
  }
  h2 {
    font-weight: 800;
    font-size: clamp(2.125rem, 1.4rem + 2.2vw, 3.25rem);
    line-height: 1;
    max-width: 18ch;
  }
  .lead {
    margin-top: 26px;
    font-size: 1.25rem;
    line-height: 1.5;
    max-width: 52ch;
  }
  .actions {
    margin-top: 40px;
  }
  @media (width <= 720px) {
    .col {
      padding-top: 64px;
      padding-bottom: 72px;
    }
    .lead {
      margin-top: 20px;
      font-size: 1.125rem;
    }
    .actions {
      margin-top: 28px;
    }
  }
</style>
