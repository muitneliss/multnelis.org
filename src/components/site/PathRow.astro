---
// One project on the contact page, as a CODEOWNERS line: the project's lane
// forks off main at its name, and the row says where to raise it (the
// repository's issues) and where it lives.
import Rail from '~/components/site/Rail.astro';
import { type Project, lanes, projectPath } from '~/data/site';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const { slug, name, track, repo, site, lane } = project;

/* Lanes that already forked above this row keep running through. */
const through = lanes.slice(0, lanes.indexOf(lane)).join(',');
const headingId = `path-${slug}`;
---

<article
  class="gs path"
  data-kind="fork"
  data-lane={lane}
  data-through={through || undefined}
  aria-labelledby={headingId}
>
  <Rail />
  <div class="col row">
    <div class="where" data-pulse-lane={lane}>
      <h3 id={headingId} data-anchor>{name}</h3>
      <p class="file mono">{projectPath(project)}</p>
    </div>
    <p class="track">
      <i class:list={['dot', `dot-${lane}`]} aria-hidden="true"></i>
      <span data-i18n={`project.${slug}.track`}>{track.en}</span>
    </p>
    <dl class="mono">
      <dt>issues</dt>
      <dd>
        <a class="arrow" href={`${repo.url}/issues`}><span>{repo.label}/issues</span>&nbsp;→</a>
      </dd>
      {
        site && (
          <>
            <dt>site</dt>
            <dd>
              <a class="arrow" href={site.url}>
                <span>{site.label}</span>&nbsp;→
              </a>
            </dd>
          </>
        )
      }
    </dl>
  </div>
</article>

<style>
  .path {
    border-top: 1px solid var(--hair);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px 300px;
    gap: 16px 40px;
    align-items: start;
    padding-top: 40px;
    padding-bottom: 44px;
    max-width: 1400px;
  }
  h3 {
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.1;
  }
  /* The repository path, a fact under the name. */
  .file {
    margin-top: 10px;
    font-size: 0.875rem;
    line-height: 1.2;
    color: var(--ink-2);
  }
  .track {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 2px;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  dl {
    margin: 0;
    padding-top: 4px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 14px;
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  dt {
    color: var(--ink-2);
  }
  dd {
    margin: 0;
    min-width: 0;
  }
  @media (width <= 1100px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .track,
    dl {
      padding-top: 0;
    }
  }
  @media (width <= 720px) {
    .row {
      padding-top: 28px;
      padding-bottom: 32px;
    }
  }
</style>
