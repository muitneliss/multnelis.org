# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# pnpm-specific files: pnpm is supported for local use (see .pnpmrc), but
# package-lock.json is the tracked lockfile and npm is what CI, Docker and
# the deploy targets run. Committing these would let the two trees diverge.
pnpm-lock.yaml
pnpm-workspace.yaml

.astro
# design workflow scratch (kept local)
.impeccable/review/
.impeccable/build/
.impeccable/mocks/
research/qualitybar/
research/codex-probe/
mockups/shots/*.png
!mockups/shots/*-desktop.png

# Playwright output; visual baselines are committed for Linux only (npm run test:e2e:update)
test-results/
playwright-report/
blob-report/
e2e/**/*-darwin.png
e2e/**/*-win32.png
